{
  "name": "mfs-stock",
  "version": "4.0.0",
  "description": "Gestion de stock multi-magasins pour distributeurs agroalimentaires (Node.js/Express/SQLite)",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "seed": "node backend/database/seed.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [],
  "author": "Meyroll DADJO HOUEGBAN",
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.0"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "backend/**/*.js",
      "!backend/server.js",
      "!backend/database/seed.js"
    ]
  },
  "overrides": {
    "tar": "^7.5.21",
    "@tootallnate/once": "^2.0.1"
  }
}
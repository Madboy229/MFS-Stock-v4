# Copier en .env — ne JAMAIS committer le fichier .env
NODE_ENV=production
PORT=3001

# Chaîne aléatoire longue, ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

DB_STORAGE=./backend/database/mfs_stock.sqlite
CORS_ORIGINS=http://localhost:3001
LOGIN_RATE_LIMIT=10

# Mots de passe des comptes de démonstration (npm run seed)
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=

# Formulaire de contact (optionnel — sans SMTP, les messages sont acceptés mais non envoyés)
CONTACT_RECIPIENT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
